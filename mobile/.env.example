# Copy to .env and fill in. Local dev values come from `npx supabase start`
# output (see README.md) — these are NOT secrets for local dev, just the
# standard Supabase CLI demo keys everyone gets.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Custom backend services (Phase 4/6) — local dev ports.
EXPO_PUBLIC_VERIFICATION_SERVICE_URL=http://127.0.0.1:4001

# Sentry (optional locally, see README.md Accounts section)
EXPO_PUBLIC_SENTRY_DSN=
